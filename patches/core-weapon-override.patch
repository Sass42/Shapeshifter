+// Conquest of Azeroth: Player::SetWeaponOverride exists (server/patches/core-weapon-override.patch).
+#define COA_WEAPON_OVERRIDE 1
 
 #include "ArenaTeam.h"
 #include "Battleground.h"
@@ -1278,7 +1281,33 @@
     }
     [[nodiscard]] Item* GetWeaponForAttack(WeaponAttackType attackType, bool useable = false) const;
     bool HasWeapon(WeaponAttackType type) const override { return GetWeaponForAttack(type, false); }
-    bool HasWeaponForAttack(WeaponAttackType type) const override { return (Unit::HasWeaponForAttack(type) && GetWeaponForAttack(type, true)); }
+    bool HasWeaponForAttack(WeaponAttackType type) const override
+    {
+        if (m_hasWeaponOverride)
+            return Unit::HasWeaponForAttack(type) && GetWeaponOverride(type);
+        return (Unit::HasWeaponForAttack(type) && GetWeaponForAttack(type, true));
+    }
+    // Conquest of Azeroth: while set, these weapon templates (nullptr: no weapon in that hand; weapons
+    // only) decide whether each hand swings, its skill (full for the level) and its normalized speed,
+    // and swings train no weapon skill. Equipped items keep enchants, procs, durability and
+    // item-dependent auras. Memory only; set and cleared by mod-shapeshift.
+    void SetWeaponOverride(ItemTemplate const* mainHand, ItemTemplate const* offHand, ItemTemplate const* ranged)
+    {
+        m_weaponOverride[BASE_ATTACK] = mainHand;
+        m_weaponOverride[OFF_ATTACK] = offHand;
+        m_weaponOverride[RANGED_ATTACK] = ranged;
+        m_hasWeaponOverride = true;
+    }
+    void ClearWeaponOverride()
+    {
+        m_weaponOverride[BASE_ATTACK] = m_weaponOverride[OFF_ATTACK] = m_weaponOverride[RANGED_ATTACK] = nullptr;
+        m_hasWeaponOverride = false;
+    }
+    [[nodiscard]] bool HasWeaponOverride() const { return m_hasWeaponOverride; }
+    [[nodiscard]] ItemTemplate const* GetWeaponOverride(WeaponAttackType type) const
+    {
+        return m_hasWeaponOverride && type < MAX_ATTACK ? m_weaponOverride[type] : nullptr;
+    }
     [[nodiscard]] Item* GetShield(bool useable = false) const;
     static WeaponAttackType GetAttackBySlot(uint8 slot);        // MAX_ATTACK if not weapon slot
     std::vector<Item*>& GetItemUpdateQueue() { return m_itemUpdateQueue; }
@@ -3008,6 +3037,8 @@
